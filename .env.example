# ============================================================
# EduAgent-Platform 环境变量模板
# ============================================================
# 使用方法：
#   cp .env.example .env
#   填入实际密钥，禁止把 .env 提交到 git（.gitignore 已忽略）
#
# 优先级：.env 文件 > 系统环境变量 > settings 默认值
# 生产环境：建议把 SECRET_KEY/DASHSCOPE_API_KEY 等敏感字段
#          通过 Vault/SOPS/K8s Secret 注入，不写进 .env 文件
# ============================================================

# ---- 应用与环境 ----
ENVIRONMENT=development              # development | staging | production | ci | smoke
DEBUG=true                            # 生产环境必须 false
PROJECT_NAME=EduAgent-Platform
VERSION=1.0.0
API_V1_STR=/api/v1

# ---- 安全与认证（生产环境必须替换默认值，SECRET_KEY >= 32 字符） ----
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=super-secret-key-please-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440      # 24 小时
ALGORITHM=HS256
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ---- OpenTelemetry 分布式追踪 ----
# 未设置 OTEL_EXPORTER_OTLP_ENDPOINT 时，trace 仅打印到 stdout
OTEL_SERVICE_NAME=edu-agent-backend
OTEL_EXPORTER_OTLP_ENDPOINT=          # 例: http://localhost:4317（Jaeger/Tempo collector）
OTEL_TRACES_EXPORTER=console          # otlp | console | none
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development

# ---- 阿里云百炼 (DashScope) LLM ----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_MODEL=qwen3.5-plus
ROUTER_HEAVY_MODEL=qwen-max
ROUTER_LIGHT_MODEL=qwen-turbo
DEFAULT_EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024

# ---- MinerU 文档解析云 API ----
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm

# ---- BGE Cross-Encoder Reranker ----
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_ENABLE_BGE=true
RERANKER_BATCH_SIZE=32
RERANKER_CACHE_DIR=

# ---- Milvus 2.4 向量库 ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION=edu_knowledge_chunks

# ---- PostgreSQL ----
# CI 用 sqlite：sqlite+aiosqlite:///./data/ci_test.db
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/edu_agent_db

# ---- Redis（broker / cache / SSE / LangGraph checkpointer） ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- MinIO 对象存储 ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=edu-agent-artifacts
MINIO_SECURE=false

# ---- Langfuse 可观测性（可选） ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Agent Harness 护栏 ----
AGENT_MAX_STEPS=15
AGENT_MAX_TOKEN_BUDGET=16000
AGENT_TIMEOUT_SECONDS=120
HITL_AUTO_APPROVE=false

# ---- 外部调用超时强杀 Watchdog（秒） ----
LLM_CALL_TIMEOUT=90
LLM_STREAM_IDLE_TIMEOUT=30
LLM_STREAM_TOTAL_TIMEOUT=150
EMBEDDING_CALL_TIMEOUT=35
SANDBOX_TOTAL_TIMEOUT=20
