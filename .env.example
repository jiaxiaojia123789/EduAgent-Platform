# ==============================================================================
# EduAgent-Platform Environment Configuration
# ==============================================================================

# Project General
PROJECT_NAME="EduAgent-Platform"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-please-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Alibaba Bailian (DashScope) Configuration
# Get your API key from: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY="sk-your-bailian-api-key-here"
DEFAULT_LLM_MODEL="qwen3.5-plus"
ROUTER_HEAVY_MODEL="qwen3.5-max"
ROUTER_LIGHT_MODEL="qwen3.5-turbo"
DEFAULT_EMBEDDING_MODEL="text-embedding-v3"
EMBEDDING_DIMENSION=1024

# Milvus 2.4 Vector Database
MILVUS_HOST="localhost"
MILVUS_PORT=19530
MILVUS_USER=""
MILVUS_PASSWORD=""
MILVUS_COLLECTION="edu_knowledge_chunks"

# PostgreSQL Database
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password123"
POSTGRES_DB="edu_agent_db"
DATABASE_URL="postgresql+asyncpg://postgres:password123@localhost:5432/edu_agent_db"

# Redis Configuration (Cache, Broker, Pub/Sub, Idempotency Lock, LangGraph Checkpointer)
# 用途：
# 1. Celery broker & result backend（agent_heavy 队列）
# 2. 任务状态持久化（Hash 形式，TTL 24h）
# 3. SSE 事件 Pub/Sub（channel: sse:task:{task_id}）
# 4. 分布式幂等锁（SET NX EX 语义）
# 5. LangGraph Checkpointer 持久化（Hash 形式，TTL 7d）
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# Object Storage (MinIO / S3)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="edu-agent-artifacts"
MINIO_SECURE=false

# Langfuse Observability
# 配置后，每个 Agent step 会作为 span 推送到 Langfuse 云端 trace
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# Agent Harness Guardrails & Resource Limits
AGENT_MAX_STEPS=15
AGENT_MAX_TOKEN_BUDGET=16000
AGENT_TIMEOUT_SECONDS=120
HITL_AUTO_APPROVE=false

# ==============================================================================
# Celery Worker 启动指南
# ==============================================================================
# 启动 4 并发 worker 消费 agent_heavy 队列：
#   celery -A app.core.celery_app.celery_app worker --loglevel=info --concurrency=4 -Q agent_heavy,default
#
# 启动 flower 监控面板（默认 http://localhost:5555）：
#   celery -A app.core.celery_app.celery_app flower
#
# 生产部署建议：
#   - 使用 systemd / supervisor 守护进程
#   - worker 与 FastAPI 分进程部署，水平扩展互不影响
#   - 开启 task_acks_late=True（已在 celery_app.py 配置）防止 worker 崩溃丢任务
