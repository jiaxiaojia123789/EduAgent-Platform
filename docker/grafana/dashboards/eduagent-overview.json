{
  "title": "EduAgent Overview",
  "uid": "eduagent-overview",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "15s",
  "tags": ["eduagent", "overview"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {"text": "Prometheus", "value": "prometheus"},
        "hide": 2,
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "LLM 调用速率 (req/s)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "sum by (agent) (rate(edu_agent_llm_calls_total[5m]))", "legendFormat": "{{agent}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 10}]}}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "P95 延迟 (ms)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "edu_agent_llm_latency_p95_ms", "legendFormat": "{{agent}}"},
        {"refId": "B", "expr": "edu_agent_llm_latency_avg_ms", "legendFormat": "{{agent}} avg"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1000}, {"color": "red", "value": 3000}]}}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "LLM 缓存命中率",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "edu_agent_llm_cache_hit_rate", "legendFormat": "{{agent}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.3}, {"color": "green", "value": 0.7}]}}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "断路器状态",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "edu_agent_circuit_breaker_state", "legendFormat": "{{breaker}} state"},
        {"refId": "B", "expr": "edu_agent_circuit_breaker_failures", "legendFormat": "{{breaker}} failures"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM 供应商健康",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "edu_agent_llm_provider_state", "legendFormat": "{{provider}} state"},
        {"refId": "B", "expr": "edu_agent_llm_provider_failures", "legendFormat": "{{provider}} failures"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Token 成本 (tokens/s)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "sum by (agent) (rate(edu_agent_llm_tokens_total[5m]))", "legendFormat": "{{agent}} total"},
        {"refId": "B", "expr": "sum by (agent) (rate(edu_agent_llm_prompt_tokens_total[5m]))", "legendFormat": "{{agent}} prompt"},
        {"refId": "C", "expr": "sum by (agent) (rate(edu_agent_llm_completion_tokens_total[5m]))", "legendFormat": "{{agent}} completion"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1000}, {"color": "red", "value": 5000}]}}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Checkpointer 后端",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "edu_agent_checkpointer_backend", "legendFormat": "{{backend}}"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "依赖连接状态",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "edu_agent_dependency_up", "legendFormat": "{{dependency}}"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    }
  ]
}
